---
interface Props {
  title?: string;
  description?: string;
}

const siteName = 'LAT';
const {
  title = siteName,
  description = 'Security writeups, exploit notes, and red-team research.',
} = Astro.props;

const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.theme = stored || (prefersLight ? 'light' : 'dark');
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="LAT home">
        <span class="brand-mark" aria-hidden="true">LAT</span>
        <span>
          <strong>LAT</strong>
          <small>writeups</small>
        </span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/#writeups">Writeups</a>
        <button id="themeToggle" class="icon-button" type="button" aria-label="Toggle theme">
          <span data-theme-icon aria-hidden="true">◐</span>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} LAT</span>
      <span>Security notes for reproducible research.</span>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById('themeToggle');
        const icon = document.querySelector('[data-theme-icon]');

        const setIcon = () => {
          if (icon) icon.textContent = root.dataset.theme === 'dark' ? '☾' : '☼';
        };

        button?.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          localStorage.setItem('theme', next);
          setIcon();
        });

        setIcon();
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #08090d;
    --surface: #111218;
    --surface-strong: #171923;
    --text: #f4f1ed;
    --muted: #a6a0a0;
    --line: rgba(255, 255, 255, 0.12);
    --accent: #ff3048;
    --accent-strong: #c8102e;
    --accent-soft: rgba(255, 48, 72, 0.12);
    --secondary: #37d399;
    --gold: #d6a85c;
    --code-bg: #0d0f14;
    --shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    --radius: 8px;
    --max: 1180px;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  :root[data-theme='light'] {
    color-scheme: light;
    --bg: #f6f1e8;
    --surface: #fffaf1;
    --surface-strong: #eee4d4;
    --text: #181411;
    --muted: #6f645c;
    --line: rgba(24, 20, 17, 0.14);
    --accent: #9f1025;
    --accent-strong: #6f0b1d;
    --accent-soft: rgba(159, 16, 37, 0.09);
    --secondary: #0b6b50;
    --gold: #9b6b24;
    --code-bg: #171411;
    --shadow: 0 18px 42px rgba(56, 42, 22, 0.14);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background: var(--bg);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100%;
    margin: 0;
    background:
      linear-gradient(90deg, rgba(255, 48, 72, 0.08) 1px, transparent 1px),
      linear-gradient(0deg, rgba(255, 48, 72, 0.055) 1px, transparent 1px),
      var(--bg);
    background-size: 56px 56px;
    color: var(--text);
    font-size: 16px;
    line-height: 1.65;
  }

  :root[data-theme='light'] body {
    background:
      linear-gradient(90deg, rgba(24, 20, 17, 0.035) 1px, transparent 1px),
      linear-gradient(0deg, rgba(24, 20, 17, 0.035) 1px, transparent 1px),
      var(--bg);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: min(var(--max), calc(100% - 32px));
    margin: 0 auto;
    padding: 16px 0;
    backdrop-filter: blur(16px);
  }

  .brand,
  .site-nav {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 12px;
    min-width: 0;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 13px;
    font-weight: 800;
    box-shadow: var(--shadow);
  }

  .brand strong,
  .brand small {
    display: block;
    letter-spacing: 0;
  }

  .brand strong {
    font-size: 15px;
    line-height: 1.1;
  }

  .brand small {
    color: var(--muted);
    font-size: 12px;
    text-transform: uppercase;
  }

  .site-nav {
    gap: 6px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
  }

  .site-nav a,
  .icon-button,
  .button {
    min-height: 38px;
    border: 1px solid transparent;
    border-radius: 6px;
  }

  .site-nav a,
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
  }

  .site-nav a:hover,
  .icon-button:hover,
  .site-nav a:focus-visible,
  .icon-button:focus-visible {
    border-color: var(--line);
    color: var(--text);
    outline: none;
  }

  .icon-button {
    width: 38px;
    padding: 0;
  }

  .page-shell {
    width: min(var(--max), calc(100% - 32px));
    margin: 0 auto;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.72fr);
    gap: 36px;
    align-items: center;
    min-height: calc(100svh - 138px);
    padding: 48px 0 28px;
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow,
  .meta-line,
  .tag,
  .difficulty,
  .field-label {
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 13px;
    font-weight: 800;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .hero h1 {
    max-width: 840px;
    font-size: 56px;
  }

  .hero p {
    max-width: 700px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 18px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 16px;
    background: var(--surface);
    color: var(--text);
    font-weight: 700;
    box-shadow: var(--shadow);
  }

  .button.primary {
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
    background: var(--accent);
    color: #fff;
  }

  .button:hover,
  .button:focus-visible {
    border-color: var(--accent);
    outline: none;
  }

  .hero-visual {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .hero-visual img {
    width: 100%;
    aspect-ratio: 1.1 / 1;
    object-fit: cover;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 28px;
    max-width: 620px;
  }

  .stat {
    min-width: 0;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
  }

  .stat strong {
    display: block;
    font-size: 22px;
  }

  .stat span {
    color: var(--muted);
    font-size: 13px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin: 28px 0 18px;
  }

  .section-heading h2 {
    font-size: 30px;
  }

  .section-heading p {
    max-width: 560px;
    margin: 0;
    color: var(--muted);
  }

  .writeup-grid {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 22px;
    align-items: start;
    padding-bottom: 56px;
  }

  .filter-panel,
  .writeup-card,
  .article-shell,
  .toc,
  .admin-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    box-shadow: var(--shadow);
  }

  .filter-panel {
    position: sticky;
    top: 92px;
    padding: 16px;
  }

  .filter-panel h3 {
    margin-bottom: 12px;
    font-size: 15px;
  }

  .search-input {
    width: 100%;
    min-height: 42px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
  }

  .search-input:focus {
    border-color: var(--accent);
    outline: none;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
  }

  button.tag {
    background: transparent;
    cursor: pointer;
  }

  .tag:hover,
  .tag.active,
  .tag:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    outline: none;
  }

  .writeup-list {
    display: grid;
    gap: 14px;
  }

  .status {
    margin-bottom: 14px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    color: var(--muted);
  }

  .status.error {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    color: var(--accent);
  }

  .writeup-card {
    display: grid;
    gap: 14px;
    padding: 20px;
  }

  .writeup-card:hover,
  .writeup-card:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 70%, var(--line));
    outline: none;
  }

  .writeup-card h3 {
    font-size: 24px;
  }

  .writeup-card p {
    margin: 0;
    color: var(--muted);
  }

  .meta-line {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--muted);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 12px;
    font-weight: 700;
  }

  .difficulty {
    color: var(--gold);
  }

  .article-hero {
    padding: 58px 0 24px;
  }

  .article-hero h1 {
    max-width: 920px;
    font-size: 48px;
  }

  .article-hero p {
    max-width: 760px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 18px;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 22px;
    align-items: start;
    padding-bottom: 64px;
  }

  .article-shell {
    min-width: 0;
    padding: 32px;
  }

  .toc {
    position: sticky;
    top: 92px;
    padding: 16px;
  }

  .toc h2 {
    margin-bottom: 12px;
    font-size: 15px;
  }

  .toc a {
    display: block;
    padding: 7px 0;
    color: var(--muted);
    font-size: 14px;
  }

  .toc a:hover {
    color: var(--accent);
  }

  .prose {
    color: var(--text);
  }

  .prose > *:first-child {
    margin-top: 0;
  }

  .prose h2,
  .prose h3 {
    margin: 34px 0 12px;
  }

  .prose h2 {
    font-size: 28px;
  }

  .prose h3 {
    font-size: 22px;
  }

  .prose p,
  .prose li {
    color: color-mix(in srgb, var(--text) 82%, var(--muted));
  }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose pre {
    overflow-x: auto;
    margin: 22px 0;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--code-bg);
    color: #f7f3ef;
  }

  .prose code {
    border-radius: 5px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.92em;
  }

  .prose pre code {
    background: transparent;
    color: inherit;
  }

  .prose blockquote {
    margin: 22px 0;
    padding: 14px 18px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    color: var(--text);
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    width: min(var(--max), calc(100% - 32px));
    margin: 0 auto;
    padding: 28px 0 36px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 940px) {
    .hero,
    .writeup-grid,
    .article-layout {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
      padding-top: 34px;
    }

    .hero h1 {
      font-size: 42px;
    }

    .hero-visual {
      max-width: 640px;
    }

    .filter-panel,
    .toc {
      position: static;
    }
  }

  @media (max-width: 640px) {
    body {
      font-size: 15px;
    }

    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-nav {
      width: 100%;
      justify-content: space-between;
    }

    .site-nav a {
      flex: 1;
    }

    .hero h1,
    .article-hero h1 {
      font-size: 34px;
    }

    .hero p,
    .article-hero p {
      font-size: 16px;
    }

    .stats-row {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
    }

    .article-shell {
      padding: 22px;
    }
  }
</style>
