---
import BlogLayout from '../layouts/BlogLayout.astro';
import { isDbConfigured, listPublishedPosts } from '../lib/posts';

let writeups = [];
let setupError = '';

try {
  writeups = await listPublishedPosts();
} catch {
  setupError = 'Cannot load posts.';
}

const tags = ['writeup'];
const categories = [...new Set(writeups.map((entry) => 'notes'))];
const latest = writeups[0];

const formatDate = (value: string | null) =>
  value
    ? new Intl.DateTimeFormat('en', {
        month: 'short',
        day: '2-digit',
        year: 'numeric',
      }).format(new Date(value))
    : 'Draft';
---

<BlogLayout
  title="LAT"
  description="Security writeups, exploit notes, and reproducible research."
>
  <section class="page-shell hero">
    <div class="hero-copy">
      <p class="eyebrow">WRITEUPS / RED NOTES</p>
      <h1>Security research with a dark red edge.</h1>
      <p>
        A focused space for CTF notes, bug bounty reports, exploit paths, and fixes. Dark mode
        keeps the hacker-console tone; light mode switches into a quieter luxury reading surface.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#writeups">Read writeups</a>
      </div>
      <div class="stats-row" aria-label="Blog stats">
        <div class="stat">
          <strong>{writeups.length}</strong>
          <span>published</span>
        </div>
        <div class="stat">
          <strong>{categories.length}</strong>
          <span>categories</span>
        </div>
        <div class="stat">
          <strong>{tags.length}</strong>
          <span>tags tracked</span>
        </div>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <img src="/images/writeup-console.svg" alt="" width="760" height="690" />
    </div>
  </section>

  <section id="writeups" class="page-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Latest research</p>
        <h2>Writeups</h2>
      </div>
      {
        latest && (
          <p>
            Latest: <strong>{latest.title}</strong> · {formatDate(latest.publishedAt)}
          </p>
        )
      }
    </div>

    {setupError && <div class="status error">{setupError}</div>}
    {!isDbConfigured() && <div class="status">Configure DATABASE_URL and run migrations to load posts from Neon.</div>}

    <div class="writeup-grid">
      <aside class="filter-panel" aria-label="Writeup filters">
        <h3>Search</h3>
        <input
          class="search-input"
          type="search"
          placeholder="Search title or description"
          data-search
          autocomplete="off"
        />
        <div class="tag-list" aria-label="Tag filters">
          <button class="tag active" type="button" data-tag="all">All</button>
          <button class="tag" type="button" data-tag="writeup">writeup</button>
        </div>
      </aside>

      <div class="writeup-list" data-list>
        {
          writeups.length > 0 ? (
            writeups.map((entry) => (
              <a
                class="writeup-card"
                href={`/writeups/${entry.slug}/`}
                data-card
                data-search-text={`${entry.title} ${entry.description} notes writeup`.toLowerCase()}
                data-tags="writeup"
              >
                <div class="meta-line">
                  <span>{formatDate(entry.publishedAt)}</span>
                  <span>/</span>
                  <span>notes</span>
                </div>
                <h3>{entry.title}</h3>
                <p>{entry.description}</p>
                <div class="tag-list">
                  <span class="tag">writeup</span>
                </div>
              </a>
            ))
          ) : (
            <div class="writeup-card">
              <div class="meta-line">No posts</div>
              <h3>No published writeups yet</h3>
              <p>Login at /admin, write a post, and publish it.</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>('[data-search]');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
    const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    let activeTag = 'all';

    const applyFilters = () => {
      const term = search?.value.trim().toLowerCase() || '';
      cards.forEach((card) => {
        const tags = card.dataset.tags?.split(',') || [];
        const matchesTag = activeTag === 'all' || tags.includes(activeTag);
        const matchesSearch = !term || card.dataset.searchText?.includes(term);
        card.hidden = !(matchesTag && matchesSearch);
      });
    };

    search?.addEventListener('input', applyFilters);
    tagButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeTag = button.dataset.tag || 'all';
        tagButtons.forEach((item) => item.classList.toggle('active', item === button));
        applyFilters();
      });
    });
  </script>
</BlogLayout>
