---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getMarkdownHeadings, renderMarkdown } from '../../lib/markdown';
import { getPublishedPostBySlug } from '../../lib/posts';

const slug = String(Astro.params.slug || '');
let entry = null;
let loadError = '';

try {
  entry = await getPublishedPostBySlug(slug);
} catch {
  loadError = 'Cannot load post.';
}

if (!entry) {
  Astro.response.status = 404;
}

const headings = entry ? getMarkdownHeadings(entry.content) : [];
const contentHtml = entry ? renderMarkdown(entry.content) : '';

const formatDate = (value: string | null) =>
  value
    ? new Intl.DateTimeFormat('en', {
        month: 'short',
        day: '2-digit',
        year: 'numeric',
      }).format(new Date(value))
    : 'Draft';
---

<BlogLayout
  title={entry?.title ?? 'Writeup not found'}
  description={entry?.description ?? 'Writeup not found.'}
>
  <article class="page-shell">
    {
      entry ? (
        <>
          <header class="article-hero">
            <p class="eyebrow">notes / writeup</p>
            <h1>{entry.title}</h1>
            <p>{entry.description}</p>
            <div class="tag-list">
              <span class="tag">{formatDate(entry.publishedAt)}</span>
              <span class="tag">writeup</span>
            </div>
          </header>

          <div class="article-layout">
            <div class="article-shell">
              <div class="prose" set:html={contentHtml} />
            </div>

            <aside class="toc" aria-label="Table of contents">
              <h2>On this page</h2>
              {headings.length > 0 ? (
                headings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)
              ) : (
                <span class="meta-line">No headings</span>
              )}
            </aside>
          </div>
        </>
      ) : (
        <header class="article-hero">
          <p class="eyebrow">404 / writeup</p>
          <h1>Writeup not found</h1>
          <p>{loadError || 'This post does not exist or is not published.'}</p>
        </header>
      )
    }
  </article>
</BlogLayout>
