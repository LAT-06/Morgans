---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups', ({ data }) => !data.draft);

  return writeups.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: '2-digit',
    year: 'numeric',
  }).format(date);
---

<BlogLayout title={entry.data.title} description={entry.data.description}>
  <article class="page-shell">
    <header class="article-hero">
      <p class="eyebrow">{entry.data.category} / writeup</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="tag-list">
        <span class="tag">{formatDate(entry.data.pubDate)}</span>
        {entry.data.updatedDate && <span class="tag">Updated {formatDate(entry.data.updatedDate)}</span>}
        {entry.data.difficulty && <span class="tag difficulty">{entry.data.difficulty}</span>}
        {entry.data.target && <span class="tag">{entry.data.target}</span>}
        {entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>

    <div class="article-layout">
      <div class="article-shell">
        <div class="prose">
          <Content />
        </div>
      </div>

      <aside class="toc" aria-label="Table of contents">
        <h2>On this page</h2>
        {
          headings.length > 0 ? (
            headings
              .filter((heading) => heading.depth === 2 || heading.depth === 3)
              .map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)
          ) : (
            <span class="meta-line">No headings</span>
          )
        }
      </aside>
    </div>
  </article>
</BlogLayout>
