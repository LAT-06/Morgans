---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Morgan Writeups CMS</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root {
        color-scheme: dark;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        background: #08090d;
        color: #f4f1ed;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          linear-gradient(90deg, rgba(255, 48, 72, 0.08) 1px, transparent 1px),
          linear-gradient(0deg, rgba(255, 48, 72, 0.055) 1px, transparent 1px),
          #08090d;
        background-size: 56px 56px;
      }

      .cms-loading {
        display: grid;
        min-height: 100vh;
        place-items: center;
        padding: 24px;
      }

      .cms-loading strong {
        display: block;
        color: #ff3048;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 14px;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .cms-loading span {
        color: #a6a0a0;
      }
    </style>
  </head>
  <body>
    <div class="cms-loading">
      <div>
        <strong>Morgan Writeups CMS</strong>
        <span>Loading editor...</span>
      </div>
    </div>
    <script is:inline src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
  </body>
</html>
